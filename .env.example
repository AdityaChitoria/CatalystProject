# Copy this file to `.env` (which is git-ignored) and fill in your own values.
# NEVER put a real key in this file - it is committed to the repo.
#
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows)
#
# Groq (OpenAI-compatible). Get a key at https://console.groq.com/keys
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
